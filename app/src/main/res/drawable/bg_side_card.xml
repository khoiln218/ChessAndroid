<?xml version="1.0" encoding="utf-8"?>
<!-- The card lights up through setActivated(), so no background swapping is needed at runtime. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/bg_side_card_active"
        android:state_activated="true" />
    <item android:drawable="@drawable/bg_side_card_idle" />
</selector>
