<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/game_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_game"
    android:orientation="vertical">

    <!-- Fixed-height slot: the banner is 50dp tall, so reserving it up front keeps the board from
         jumping down when the ad finally arrives. -->
    <FrameLayout
        android:id="@+id/ad_slot"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ad_banner_height"
        android:layout_marginStart="12dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="24dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Computer: identity on the left, clock on the right -->
    <LinearLayout
        android:id="@+id/computer_side"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_side_card"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="6dp"
        android:paddingBottom="8dp">

        <!-- The machine's face, with what it is set to play at pinned across the foot of it. -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/computer_avatar"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_avatar_red"
                android:padding="5dp"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/computer_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/bg_level_badge"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:textColor="@color/gold"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:ignore="SmallSp"
                tools:text="Cực khó" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="start"
            android:orientation="vertical">

            <TextView
                android:id="@+id/computer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.02"
                android:text="@string/computer_label"
                android:textColor="@color/sideRed"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/computer_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_waiting"
                android:textColor="@color/textMuted"
                android:textSize="13sp" />
        </LinearLayout>

        <com.ttnt.chinesechess.view.TurnTimerView
            android:id="@+id/computer_timer"
            android:layout_width="52dp"
            android:layout_height="52dp" />

        <!-- What the machine is set to do, next to the machine itself: strength, and who opens. -->
        <ImageButton
            android:id="@+id/settings_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/settings_label"
            android:padding="8dp"
            android:src="@drawable/ic_settings"
            app:tint="@color/gold" />

    </LinearLayout>

    <!-- The board, and one thing that may sit on top of it. The padding is even top and bottom,
         so the centre of this frame is the centre of the board - which is the river. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp" />

        <!-- Brushed across the board as a game opens, then gone. Serif bold is the same
             register the river characters are drawn in, so it reads as part of the board. -->
        <TextView
            android:id="@+id/board_flourish"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:elevation="8dp"
            android:fontFamily="serif"
            android:letterSpacing="0.18"
            android:shadowColor="#66000000"
            android:shadowDx="0"
            android:shadowDy="3"
            android:shadowRadius="10"
            android:text="@string/start_label"
            android:textColor="@color/gold"
            android:textSize="36sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- The one thing that sets a game going, wearing whichever word fits: it invites the
             first game on the way in, and offers the next one after a finished one is dismissed.
             The text here is only the first of those; the other is set from code. -->
        <Button
            android:id="@+id/river_new_game"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_button_pill"
            android:elevation="6dp"
            android:letterSpacing="0.06"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="5dp"
            android:stateListAnimator="@null"
            android:text="@string/ready_label"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Player: mirrored, so the two sides read as facing each other across the board -->
    <LinearLayout
        android:id="@+id/player_side"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_side_card"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/menu_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/menu_label"
            android:padding="8dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/gold" />

        <com.ttnt.chinesechess.view.TurnTimerView
            android:id="@+id/player_timer"
            android:layout_width="52dp"
            android:layout_height="52dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/player_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.02"
                android:text="@string/player_label"
                android:textColor="@color/sideBlack"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/player_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_your_turn"
                android:textColor="@color/textMuted"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/player_avatar"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_avatar_black"
            android:padding="5dp"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
